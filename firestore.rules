rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // The email is confirmed: always for Google, and for email accounts once
    // the emailed code was entered. Unconfirmed accounts reach no user data,
    // so the code check cannot be skipped by calling Firebase directly.
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // The hospital membership. Only the server (Admin SDK) writes these, when
    // someone joins with their hospital's code.
    function orgKeys() {
      return ['orgId', 'orgJoinedAt', 'orgConsentAt'];
    }

    // The orgId on the signed-in user's own profile, or null.
    function myOrgId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('orgId', null);
    }

    match /users/{userId} {
      // Owner-only. This also lets the app set `journalsMigratedAt` once the
      // old journal entries have been moved. The app may never set or change
      // the hospital membership.
      allow read, delete: if isOwner(userId) && verified();
      allow create: if isOwner(userId) && verified()
        && !request.resource.data.keys().hasAny(orgKeys());
      allow update: if isOwner(userId) && verified()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(orgKeys());

      match /moods/{moodId} {
        allow create, read, update, delete: if isOwner(userId) && verified();
      }

      match /meditation_sessions/{sessionId} {
        allow create, read, update, delete: if isOwner(userId) && verified();
      }

      match /checkins/{checkInId} {
        allow create, read, update, delete: if isOwner(userId) && verified();
      }

      match /gratitude/{entryId} {
        allow create, read, update, delete: if isOwner(userId) && verified();
      }

      match /breaks/{breakId} {
        allow create, read, update, delete: if isOwner(userId) && verified();
      }

      match /journals/{entryId} {
        allow create, read, update, delete: if isOwner(userId) && verified();
      }

      match /assessments/{resultId} {
        allow create, read, update, delete: if isOwner(userId) && verified();
      }

      // Drafts are kept on the phone today; this lets account deletion
      // check the collection (and clear it if it is ever used).
      match /journal_drafts/{draftId} {
        allow create, read, update, delete: if isOwner(userId) && verified();
      }

      // "Your officer was asked to reach out" records. Written only by the
      // server; the owner reads them, and deletes them with their account.
      match /wellbeing_alerts/{alertId} {
        allow read, delete: if isOwner(userId) && verified();
      }
    }

    // Hospitals: name, code and wellbeing officer. Readable by a verified
    // member of that hospital only; written only by the admin script.
    match /organizations/{orgId} {
      allow read: if verified() && myOrgId() == orgId;
      // No rule for organizations/{orgId}/private/{doc} (the officer's
      // email), on purpose: this rule does not reach subcollections, and with
      // no matching rule Firestore denies every client. Only the server
      // (Admin SDK) reads it.
    }

    // The server's alert bookkeeping. No client access.
    match /alert_state/{doc} {
      allow read, write: if false;
    }

    // The old top-level journal collection. Kept only so the app can read
    // and delete old entries while moving them to users/{uid}/journals.
    // Remove this rule once everyone has migrated.
    match /journals/{journalId} {
      allow create: if isSignedIn() && verified()
        && request.resource.data.userId == request.auth.uid;

      allow read, update, delete: if isSignedIn() && verified()
        && request.auth.uid == resource.data.userId;
    }

    // Pending sign-up codes. Only the email-code server (Admin SDK, which
    // skips these rules) may use them; the app never can.
    match /email_otp/{doc} {
      allow read, write: if false;
    }
  }
}
